{
  "info": {
    "_postman_id": "a9b8c7d6-e5f4-4321-8765-1234567890ab",
    "name": "Schedula Backend - Day 12 Rescheduling & Appointment Management API Suite",
    "description": "Production Postman Collection for NestJS Schedula Backend API containing Authentication, Onboarding, Scheduling, Booking, Rescheduling, and Cancellation endpoints with automated Bearer Token management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Patient User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient_reschedule@test.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"PATIENT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signup"]
            }
          }
        },
        {
          "name": "Login Patient User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.environment.set(\"patientToken\", jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient_reschedule@test.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Appointment Booking & Rescheduling (Day 12)",
      "item": [
        {
          "name": "Book Appointment (STREAM)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"appointmentDate\": \"2026-08-15\",\n  \"startTime\": \"10:00\",\n  \"endTime\": \"10:15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/appointment",
              "host": ["{{baseUrl}}"],
              "path": ["appointment"]
            }
          }
        },
        {
          "name": "Reschedule Appointment (PATCH /appointment/:id/reschedule)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentDate\": \"2026-08-15\",\n  \"startTime\": \"10:20\",\n  \"endTime\": \"10:35\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/appointment/{{appointmentId}}/reschedule",
              "host": ["{{baseUrl}}"],
              "path": ["appointment", "{{appointmentId}}", "reschedule"]
            }
          }
        },
        {
          "name": "Cancel Appointment (30-Min Cutoff Protected)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/appointment/{{appointmentId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["appointment", "{{appointmentId}}", "cancel"]
            }
          }
        },
        {
          "name": "Fetch Patient Appointments (/appointment/my)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/appointment/my",
              "host": ["{{baseUrl}}"],
              "path": ["appointment", "my"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://schedula-backend-45oj.onrender.com",
      "type": "string"
    }
  ]
}
