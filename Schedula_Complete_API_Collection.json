        {
          "name": "Login Doctor User (POST /auth/login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    if (data.access_token) {",
                  "        pm.collectionVariables.set(\"authToken\", data.access_token);",
                  "        if (data.user && data.user.id) {",
                  "            pm.collectionVariables.set(\"doctorUserId\", data.user.id);",
